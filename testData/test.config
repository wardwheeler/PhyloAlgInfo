Graph graphOne {
	Leaves : 100;
	Roots : 1;
	Singletons : 0;
	NetworkEdges : 0;
};

Machine m0 {
	Graph : graphOne;
	Block : archea_short.fas : 1;
};

BlockModel archea_short.fas {
	Alphabet : ["-","A","C","G","T"];
	BranchLength : Exponential: 10;
	RateModifiers : Gamma : (classes:8, alpha:0.750);
	ChangeModel :neyman;
	Precision : 1000;
	Length : 500;
};
